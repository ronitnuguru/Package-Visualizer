{
  "type": "lightning__agentforceWidget",
  "contentBody": {
    "widgetBody": {
      "definition": "tile/widget",
      "children": [
        {
          "definition": "tile/column",
          "attributes": {
            "gap": "md"
          },
          "children": [
            {
              "definition": "tile/callout",
              "meta": {
                "if": "{!NOT($attrs.isSuccess)}"
              },
              "attributes": {
                "title": "Unable to load package details",
                "description": "{!$attrs.errorMessage}",
                "variant": "error"
              }
            },
            {
              "definition": "tile/container",
              "meta": {
                "if": "{!$attrs.isSuccess}"
              },
              "children": [
                {
                  "definition": "tile/column",
                  "attributes": {
                    "gap": "md"
                  },
                  "children": [
                    {
                      "definition": "tile/row",
                      "attributes": {
                        "gap": "sm",
                        "align": "center",
                        "justify": "between"
                      },
                      "children": [
                        {
                          "definition": "tile/row",
                          "attributes": {
                            "gap": "sm",
                            "align": "center"
                          },
                          "children": [
                            {
                              "definition": "tile/icon",
                              "attributes": {
                                "name": "{!IF($attrs.packageType == 'Managed', 'lightbulb', 'palette')}",
                                "size": "lg",
                                "color": "primary",
                                "alt": "{!$attrs.packageType}"
                              }
                            },
                            {
                              "definition": "tile/text",
                              "attributes": {
                                "text": "{!$attrs.name}",
                                "variant": "h2"
                              }
                            },
                            {
                              "definition": "tile/badge",
                              "attributes": {
                                "label": "{!$attrs.packageType}",
                                "variant": "outline"
                              }
                            }
                          ]
                        },
                        {
                          "definition": "tile/link",
                          "attributes": {
                            "href": "{!$attrs.openInSalesforceUrl}",
                            "text": "Open in Salesforce",
                            "variant": "primary",
                            "underline": "hover"
                          }
                        }
                      ]
                    },
                    {
                      "definition": "tile/column",
                      "attributes": {
                        "gap": "xs"
                      },
                      "children": [
                        {
                          "definition": "tile/row",
                          "attributes": {
                            "gap": "lg",
                            "align": "start",
                            "isWrapped": true
                          },
                          "children": [
                            {
                              "definition": "tile/column",
                              "attributes": {
                                "gap": "md",
                                "width": "stretch"
                              },
                              "children": [
                                {
                                  "definition": "tile/column",
                                  "attributes": {
                                    "gap": "xs"
                                  },
                                  "children": [
                                    {
                                      "definition": "tile/text",
                                      "attributes": {
                                        "text": "Name",
                                        "variant": "body",
                                        "weight": "semibold"
                                      }
                                    },
                                    {
                                      "definition": "tile/text",
                                      "attributes": {
                                        "text": "{!$attrs.name}",
                                        "variant": "body"
                                      }
                                    }
                                  ]
                                },
                                {
                                  "definition": "tile/column",
                                  "attributes": {
                                    "gap": "xs"
                                  },
                                  "children": [
                                    {
                                      "definition": "tile/text",
                                      "attributes": {
                                        "text": "Namespace Prefix",
                                        "variant": "body",
                                        "weight": "semibold"
                                      }
                                    },
                                    {
                                      "definition": "tile/text",
                                      "attributes": {
                                        "text": "{!$attrs.namespacePrefix}",
                                        "variant": "body"
                                      }
                                    }
                                  ]
                                },
                                {
                                  "definition": "tile/column",
                                  "attributes": {
                                    "gap": "xs"
                                  },
                                  "children": [
                                    {
                                      "definition": "tile/text",
                                      "attributes": {
                                        "text": "Package ID",
                                        "variant": "body",
                                        "weight": "semibold"
                                      }
                                    },
                                    {
                                      "definition": "tile/text",
                                      "attributes": {
                                        "text": "{!$attrs.package2Id}",
                                        "variant": "code"
                                      }
                                    }
                                  ]
                                },
                                {
                                  "definition": "tile/column",
                                  "attributes": {
                                    "gap": "xs"
                                  },
                                  "children": [
                                    {
                                      "definition": "tile/text",
                                      "attributes": {
                                        "text": "Subscriber Package ID",
                                        "variant": "body",
                                        "weight": "semibold"
                                      }
                                    },
                                    {
                                      "definition": "tile/text",
                                      "attributes": {
                                        "text": "{!$attrs.subscriberPackageId}",
                                        "variant": "code"
                                      }
                                    }
                                  ]
                                },
                                {
                                  "definition": "tile/column",
                                  "attributes": {
                                    "gap": "xs"
                                  },
                                  "children": [
                                    {
                                      "definition": "tile/text",
                                      "attributes": {
                                        "text": "Description",
                                        "variant": "body",
                                        "weight": "semibold"
                                      }
                                    },
                                    {
                                      "definition": "tile/text",
                                      "attributes": {
                                        "text": "{!$attrs.description}",
                                        "variant": "body"
                                      }
                                    }
                                  ]
                                }
                              ]
                            },
                            {
                              "definition": "tile/column",
                              "attributes": {
                                "gap": "md",
                                "width": "stretch"
                              },
                              "children": [
                                {
                                  "definition": "tile/row",
                                  "attributes": {
                                    "gap": "xs",
                                    "align": "center"
                                  },
                                  "children": [
                                    {
                                      "definition": "tile/icon",
                                      "attributes": {
                                        "name": "{!IF($attrs.appAnalyticsEnabled, 'check-circle', 'x-circle')}",
                                        "size": "sm",
                                        "color": "{!IF($attrs.appAnalyticsEnabled, 'success', 'error')}",
                                        "alt": ""
                                      }
                                    },
                                    {
                                      "definition": "tile/text",
                                      "attributes": {
                                        "text": "AppAnalytics Enabled",
                                        "variant": "body"
                                      }
                                    }
                                  ]
                                },
                                {
                                  "definition": "tile/row",
                                  "attributes": {
                                    "gap": "xs",
                                    "align": "center"
                                  },
                                  "children": [
                                    {
                                      "definition": "tile/icon",
                                      "attributes": {
                                        "name": "{!IF($attrs.wasTransferred, 'check-circle', 'x-circle')}",
                                        "size": "sm",
                                        "color": "{!IF($attrs.wasTransferred, 'success', 'error')}",
                                        "alt": ""
                                      }
                                    },
                                    {
                                      "definition": "tile/text",
                                      "attributes": {
                                        "text": "Was Transferred",
                                        "variant": "body"
                                      }
                                    }
                                  ]
                                },
                                {
                                  "definition": "tile/row",
                                  "attributes": {
                                    "gap": "xs",
                                    "align": "center"
                                  },
                                  "children": [
                                    {
                                      "definition": "tile/icon",
                                      "attributes": {
                                        "name": "{!IF($attrs.dataCloudPackage, 'check-circle', 'x-circle')}",
                                        "size": "sm",
                                        "color": "{!IF($attrs.dataCloudPackage, 'success', 'error')}",
                                        "alt": ""
                                      }
                                    },
                                    {
                                      "definition": "tile/text",
                                      "attributes": {
                                        "text": "Data360 Package",
                                        "variant": "body"
                                      }
                                    }
                                  ]
                                },
                                {
                                  "definition": "tile/column",
                                  "attributes": {
                                    "gap": "xs"
                                  },
                                  "children": [
                                    {
                                      "definition": "tile/text",
                                      "attributes": {
                                        "text": "Package Error Username",
                                        "variant": "body",
                                        "weight": "semibold"
                                      }
                                    },
                                    {
                                      "definition": "tile/text",
                                      "attributes": {
                                        "text": "{!$attrs.packageErrorUsername}",
                                        "variant": "body"
                                      }
                                    }
                                  ]
                                },
                                {
                                  "definition": "tile/column",
                                  "attributes": {
                                    "gap": "xs"
                                  },
                                  "children": [
                                    {
                                      "definition": "tile/text",
                                      "attributes": {
                                        "text": "Created By",
                                        "variant": "body",
                                        "weight": "semibold"
                                      }
                                    },
                                    {
                                      "definition": "tile/text",
                                      "attributes": {
                                        "text": "{!$attrs.createdBy}",
                                        "variant": "body"
                                      }
                                    }
                                  ]
                                },
                                {
                                  "definition": "tile/column",
                                  "attributes": {
                                    "gap": "xs"
                                  },
                                  "children": [
                                    {
                                      "definition": "tile/text",
                                      "attributes": {
                                        "text": "Created Date",
                                        "variant": "body",
                                        "weight": "semibold"
                                      }
                                    },
                                    {
                                      "definition": "tile/text",
                                      "attributes": {
                                        "text": "{!$attrs.createdDate}",
                                        "variant": "body"
                                      }
                                    }
                                  ]
                                }
                              ]
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "definition": "tile/row",
                      "attributes": {
                        "gap": "sm"
                      },
                      "children": [
                        {
                          "definition": "tile/button",
                          "attributes": {
                            "label": "Back to packages",
                            "variant": "secondary",
                            "actions": {
                              "click": [
                                {
                                  "definition": "action/sendMessage",
                                  "attributes": {
                                    "content": "Show active packages"
                                  }
                                }
                              ]
                            }
                          }
                        },
                        {
                          "definition": "tile/button",
                          "attributes": {
                            "label": "View Package Versions",
                            "variant": "secondary",
                            "actions": {
                              "click": [
                                {
                                  "definition": "action/sendMessage",
                                  "attributes": {
                                    "content": "{!$attrs.package2Id}"
                                  }
                                }
                              ]
                            }
                          }
                        },
                        {
                          "definition": "tile/button",
                          "attributes": {
                            "label": "View Subscribers",
                            "variant": "secondary",
                            "actions": {
                              "click": [
                                {
                                  "definition": "action/sendMessage",
                                  "attributes": {
                                    "content": "View subscribers for package {!$attrs.subscriberPackageId}"
                                  }
                                }
                              ]
                            }
                          }
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  }
}
