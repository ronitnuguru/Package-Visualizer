{
  "definition": "tile/widget",
  "children": [
    {
      "definition": "tile/column",
      "attributes": {
        "gap": "md"
      },
      "children": [
        {
          "definition": "tile/callout",
          "meta": {
            "if": "{!NOT($isSuccess)}"
          },
          "attributes": {
            "title": "Unable to load subscriber details",
            "description": "{!$errorMessage}",
            "variant": "error"
          }
        },
        {
          "definition": "tile/container",
          "meta": {
            "if": "{!$isSuccess}"
          },
          "children": [
            {
              "definition": "tile/column",
              "attributes": {
                "gap": "md"
              },
              "children": [
                {
                  "definition": "tile/row",
                  "attributes": {
                    "gap": "sm",
                    "align": "center",
                    "justify": "between"
                  },
                  "children": [
                    {
                      "definition": "tile/row",
                      "attributes": {
                        "gap": "sm",
                        "align": "center"
                      },
                      "children": [
                        {
                          "definition": "tile/icon",
                          "attributes": {
                            "name": "groups",
                            "size": "lg",
                            "color": "primary",
                            "alt": ""
                          }
                        },
                        {
                          "definition": "tile/text",
                          "attributes": {
                            "text": "{!$orgName}",
                            "variant": "h2"
                          }
                        }
                      ]
                    },
                    {
                      "definition": "tile/link",
                      "attributes": {
                        "href": "{!$openInSalesforceUrl}",
                        "text": "Open in Salesforce",
                        "variant": "primary",
                        "underline": "hover"
                      }
                    }
                  ]
                },
                {
                  "definition": "tile/row",
                  "attributes": {
                    "gap": "lg",
                    "align": "start",
                    "isWrapped": true
                  },
                  "children": [
                    {
                      "definition": "tile/column",
                      "attributes": {
                        "gap": "md",
                        "width": "stretch"
                      },
                      "children": [
                        {
                          "definition": "tile/column",
                          "attributes": {
                            "gap": "xs"
                          },
                          "children": [
                            {
                              "definition": "tile/text",
                              "attributes": {
                                "text": "Organization Type",
                                "variant": "body",
                                "weight": "semibold"
                              }
                            },
                            {
                              "definition": "tile/text",
                              "attributes": {
                                "text": "{!$orgType}",
                                "variant": "body"
                              }
                            }
                          ]
                        },
                        {
                          "definition": "tile/column",
                          "attributes": {
                            "gap": "xs"
                          },
                          "children": [
                            {
                              "definition": "tile/text",
                              "attributes": {
                                "text": "Organization Status",
                                "variant": "body",
                                "weight": "semibold"
                              }
                            },
                            {
                              "definition": "tile/text",
                              "attributes": {
                                "text": "{!$orgStatus}",
                                "variant": "body"
                              }
                            }
                          ]
                        },
                        {
                          "definition": "tile/column",
                          "attributes": {
                            "gap": "xs"
                          },
                          "children": [
                            {
                              "definition": "tile/text",
                              "attributes": {
                                "text": "Instance Name",
                                "variant": "body",
                                "weight": "semibold"
                              }
                            },
                            {
                              "definition": "tile/text",
                              "attributes": {
                                "text": "{!$instanceName}",
                                "variant": "body"
                              }
                            }
                          ]
                        },
                        {
                          "definition": "tile/column",
                          "attributes": {
                            "gap": "xs"
                          },
                          "children": [
                            {
                              "definition": "tile/text",
                              "attributes": {
                                "text": "Organization Key",
                                "variant": "body",
                                "weight": "semibold"
                              }
                            },
                            {
                              "definition": "tile/text",
                              "attributes": {
                                "text": "{!$orgKey}",
                                "variant": "code"
                              }
                            }
                          ]
                        },
                        {
                          "definition": "tile/column",
                          "attributes": {
                            "gap": "xs"
                          },
                          "children": [
                            {
                              "definition": "tile/text",
                              "attributes": {
                                "text": "Parent Organization",
                                "variant": "body",
                                "weight": "semibold"
                              }
                            },
                            {
                              "definition": "tile/text",
                              "attributes": {
                                "text": "{!IF(ISBLANK($parentOrg), 'None', $parentOrg)}",
                                "variant": "body"
                              }
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "definition": "tile/column",
                      "attributes": {
                        "gap": "md",
                        "width": "stretch"
                      },
                      "children": [
                        {
                          "definition": "tile/row",
                          "attributes": {
                            "gap": "xs",
                            "align": "center"
                          },
                          "children": [
                            {
                              "definition": "tile/icon",
                              "attributes": {
                                "name": "{!IF($hasRestrictionEnabled, 'check-circle', 'x-circle')}",
                                "size": "sm",
                                "color": "{!IF($hasRestrictionEnabled, 'success', 'error')}",
                                "alt": ""
                              }
                            },
                            {
                              "definition": "tile/text",
                              "attributes": {
                                "text": "Restriction Enabled",
                                "variant": "body"
                              }
                            }
                          ]
                        },
                        {
                          "definition": "tile/row",
                          "attributes": {
                            "gap": "xs",
                            "align": "center"
                          },
                          "children": [
                            {
                              "definition": "tile/icon",
                              "attributes": {
                                "name": "{!IF($isCustomUpgradeAllowed, 'check-circle', 'x-circle')}",
                                "size": "sm",
                                "color": "{!IF($isCustomUpgradeAllowed, 'success', 'error')}",
                                "alt": ""
                              }
                            },
                            {
                              "definition": "tile/text",
                              "attributes": {
                                "text": "Custom Upgrade Allowed",
                                "variant": "body"
                              }
                            }
                          ]
                        },
                        {
                          "definition": "tile/column",
                          "meta": {
                            "if": "{!NOT(ISBLANK($customUpgradeType))}"
                          },
                          "attributes": {
                            "gap": "xs"
                          },
                          "children": [
                            {
                              "definition": "tile/text",
                              "attributes": {
                                "text": "Custom Upgrade Type",
                                "variant": "body",
                                "weight": "semibold"
                              }
                            },
                            {
                              "definition": "tile/text",
                              "attributes": {
                                "text": "{!$customUpgradeType}",
                                "variant": "body"
                              }
                            }
                          ]
                        }
                      ]
                    }
                  ]
                },
                {
                  "definition": "tile/row",
                  "attributes": {
                    "gap": "sm"
                  },
                  "children": [
                    {
                      "definition": "tile/button",
                      "attributes": {
                        "label": "Back to Subscribers",
                        "variant": "secondary",
                        "actions": {
                          "click": [
                            {
                              "definition": "action/sendMessage",
                              "attributes": {
                                "content": "back-to-subscribers"
                              }
                            }
                          ]
                        }
                      }
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
