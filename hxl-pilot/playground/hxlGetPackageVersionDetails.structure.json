{
  "definition": "tile/widget",
  "children": [
    {
      "definition": "tile/column",
      "attributes": {
        "gap": "md"
      },
      "children": [
        {
          "definition": "tile/callout",
          "meta": {
            "if": "{!NOT($isSuccess)}"
          },
          "attributes": {
            "title": "Unable to load package version details",
            "description": "{!$errorMessage}",
            "variant": "error"
          }
        },
        {
          "definition": "tile/container",
          "meta": {
            "if": "{!$isSuccess}"
          },
          "children": [
            {
              "definition": "tile/column",
              "attributes": {
                "gap": "md"
              },
              "children": [
                {
                  "definition": "tile/row",
                  "attributes": {
                    "gap": "sm",
                    "align": "center",
                    "justify": "between"
                  },
                  "children": [
                    {
                      "definition": "tile/row",
                      "attributes": {
                        "gap": "sm",
                        "align": "center"
                      },
                      "children": [
                        {
                          "definition": "tile/icon",
                          "attributes": {
                            "name": "{!IF($packageType == 'Managed', 'lightbulb', 'palette')}",
                            "size": "lg",
                            "color": "primary",
                            "alt": "{!$packageType}"
                          }
                        },
                        {
                          "definition": "tile/text",
                          "attributes": {
                            "text": "{!$name}",
                            "variant": "h2"
                          }
                        },
                        {
                          "definition": "tile/badge",
                          "attributes": {
                            "label": "{!$packageType}",
                            "variant": "outline"
                          }
                        }
                      ]
                    },
                    {
                      "definition": "tile/link",
                      "attributes": {
                        "href": "{!$openInSalesforceUrl}",
                        "text": "Open in Salesforce",
                        "variant": "primary",
                        "underline": "hover"
                      }
                    }
                  ]
                },
                {
                  "definition": "tile/column",
                  "attributes": {
                    "gap": "xs"
                  },
                  "children": [
                    {
                      "definition": "tile/row",
                      "attributes": {
                        "gap": "lg",
                        "align": "start",
                        "isWrapped": true
                      },
                      "children": [
                        {
                          "definition": "tile/column",
                          "attributes": {
                            "gap": "md",
                            "width": "stretch"
                          },
                          "children": [
                            {
                              "definition": "tile/column",
                              "attributes": {
                                "gap": "xs"
                              },
                              "children": [
                                {
                                  "definition": "tile/text",
                                  "attributes": {
                                    "text": "Version Name",
                                    "variant": "body",
                                    "weight": "semibold"
                                  }
                                },
                                {
                                  "definition": "tile/text",
                                  "attributes": {
                                    "text": "{!$versionName}",
                                    "variant": "body"
                                  }
                                }
                              ]
                            },
                            {
                              "definition": "tile/column",
                              "attributes": {
                                "gap": "xs"
                              },
                              "children": [
                                {
                                  "definition": "tile/text",
                                  "attributes": {
                                    "text": "Version Number",
                                    "variant": "body",
                                    "weight": "semibold"
                                  }
                                },
                                {
                                  "definition": "tile/text",
                                  "attributes": {
                                    "text": "{!$versionNumber}",
                                    "variant": "code"
                                  }
                                }
                              ]
                            },
                            {
                              "definition": "tile/column",
                              "attributes": {
                                "gap": "xs"
                              },
                              "children": [
                                {
                                  "definition": "tile/text",
                                  "attributes": {
                                    "text": "Ancestor ID",
                                    "variant": "body",
                                    "weight": "semibold"
                                  }
                                },
                                {
                                  "definition": "tile/text",
                                  "attributes": {
                                    "text": "{!$ancestorId}",
                                    "variant": "code"
                                  }
                                }
                              ]
                            },
                            {
                              "definition": "tile/column",
                              "attributes": {
                                "gap": "xs"
                              },
                              "children": [
                                {
                                  "definition": "tile/text",
                                  "attributes": {
                                    "text": "Package Subscriber Version ID",
                                    "variant": "body",
                                    "weight": "semibold"
                                  }
                                },
                                {
                                  "definition": "tile/text",
                                  "attributes": {
                                    "text": "{!$subscriberPackageVersionId}",
                                    "variant": "code"
                                  }
                                }
                              ]
                            },
                            {
                              "definition": "tile/column",
                              "attributes": {
                                "gap": "xs"
                              },
                              "children": [
                                {
                                  "definition": "tile/text",
                                  "attributes": {
                                    "text": "Package Install (url)",
                                    "variant": "body",
                                    "weight": "semibold"
                                  }
                                },
                                {
                                  "definition": "tile/link",
                                  "attributes": {
                                    "href": "{!$installUrl}",
                                    "text": "{!$installUrl}",
                                    "variant": "primary",
                                    "underline": "hover"
                                  }
                                }
                              ]
                            },
                            {
                              "definition": "tile/column",
                              "attributes": {
                                "gap": "xs"
                              },
                              "children": [
                                {
                                  "definition": "tile/text",
                                  "attributes": {
                                    "text": "Package Install (sf)",
                                    "variant": "body",
                                    "weight": "semibold"
                                  }
                                },
                                {
                                  "definition": "tile/text",
                                  "attributes": {
                                    "text": "{!$installSfCommand}",
                                    "variant": "code"
                                  }
                                }
                              ]
                            },
                            {
                              "definition": "tile/column",
                              "attributes": {
                                "gap": "xs"
                              },
                              "children": [
                                {
                                  "definition": "tile/text",
                                  "attributes": {
                                    "text": "Branch",
                                    "variant": "body",
                                    "weight": "semibold"
                                  }
                                },
                                {
                                  "definition": "tile/text",
                                  "attributes": {
                                    "text": "{!$branch}",
                                    "variant": "body"
                                  }
                                }
                              ]
                            },
                            {
                              "definition": "tile/column",
                              "attributes": {
                                "gap": "xs"
                              },
                              "children": [
                                {
                                  "definition": "tile/text",
                                  "attributes": {
                                    "text": "Tag",
                                    "variant": "body",
                                    "weight": "semibold"
                                  }
                                },
                                {
                                  "definition": "tile/text",
                                  "attributes": {
                                    "text": "{!$tag}",
                                    "variant": "body"
                                  }
                                }
                              ]
                            },
                            {
                              "definition": "tile/column",
                              "attributes": {
                                "gap": "xs"
                              },
                              "children": [
                                {
                                  "definition": "tile/text",
                                  "attributes": {
                                    "text": "Description",
                                    "variant": "body",
                                    "weight": "semibold"
                                  }
                                },
                                {
                                  "definition": "tile/text",
                                  "attributes": {
                                    "text": "{!$description}",
                                    "variant": "body"
                                  }
                                }
                              ]
                            }
                          ]
                        },
                        {
                          "definition": "tile/column",
                          "attributes": {
                            "gap": "md",
                            "width": "stretch"
                          },
                          "children": [
                            {
                              "definition": "tile/row",
                              "attributes": {
                                "gap": "xs",
                                "align": "center"
                              },
                              "children": [
                                {
                                  "definition": "tile/icon",
                                  "attributes": {
                                    "name": "{!IF($isReleased, 'check-circle', 'x-circle')}",
                                    "size": "sm",
                                    "color": "{!IF($isReleased, 'success', 'error')}",
                                    "alt": ""
                                  }
                                },
                                {
                                  "definition": "tile/text",
                                  "attributes": {
                                    "text": "Is Released",
                                    "variant": "body"
                                  }
                                }
                              ]
                            },
                            {
                              "definition": "tile/row",
                              "attributes": {
                                "gap": "xs",
                                "align": "center"
                              },
                              "children": [
                                {
                                  "definition": "tile/icon",
                                  "attributes": {
                                    "name": "{!IF($isPasswordProtected, 'check-circle', 'x-circle')}",
                                    "size": "sm",
                                    "color": "{!IF($isPasswordProtected, 'success', 'error')}",
                                    "alt": ""
                                  }
                                },
                                {
                                  "definition": "tile/text",
                                  "attributes": {
                                    "text": "Is Password Protected",
                                    "variant": "body"
                                  }
                                }
                              ]
                            },
                            {
                              "definition": "tile/row",
                              "attributes": {
                                "gap": "xs",
                                "align": "center"
                              },
                              "children": [
                                {
                                  "definition": "tile/icon",
                                  "attributes": {
                                    "name": "{!IF($hasPassedCodeCoverageCheck, 'check-circle', 'x-circle')}",
                                    "size": "sm",
                                    "color": "{!IF($hasPassedCodeCoverageCheck, 'success', 'error')}",
                                    "alt": ""
                                  }
                                },
                                {
                                  "definition": "tile/text",
                                  "attributes": {
                                    "text": "Has Passed Code Coverage Check",
                                    "variant": "body"
                                  }
                                }
                              ]
                            },
                            {
                              "definition": "tile/row",
                              "attributes": {
                                "gap": "xs",
                                "align": "center"
                              },
                              "children": [
                                {
                                  "definition": "tile/icon",
                                  "attributes": {
                                    "name": "{!IF($validatedAsync, 'check-circle', 'x-circle')}",
                                    "size": "sm",
                                    "color": "{!IF($validatedAsync, 'success', 'error')}",
                                    "alt": ""
                                  }
                                },
                                {
                                  "definition": "tile/text",
                                  "attributes": {
                                    "text": "Validated Async",
                                    "variant": "body"
                                  }
                                }
                              ]
                            },
                            {
                              "definition": "tile/row",
                              "attributes": {
                                "gap": "xs",
                                "align": "center"
                              },
                              "children": [
                                {
                                  "definition": "tile/icon",
                                  "attributes": {
                                    "name": "{!IF($validationSkipped, 'check-circle', 'x-circle')}",
                                    "size": "sm",
                                    "color": "{!IF($validationSkipped, 'success', 'error')}",
                                    "alt": ""
                                  }
                                },
                                {
                                  "definition": "tile/text",
                                  "attributes": {
                                    "text": "Validation Skipped",
                                    "variant": "body"
                                  }
                                }
                              ]
                            },
                            {
                              "definition": "tile/row",
                              "attributes": {
                                "gap": "xs",
                                "align": "center"
                              },
                              "children": [
                                {
                                  "definition": "tile/icon",
                                  "attributes": {
                                    "name": "{!IF($hasMetadataRemoved, 'check-circle', 'x-circle')}",
                                    "size": "sm",
                                    "color": "{!IF($hasMetadataRemoved, 'success', 'error')}",
                                    "alt": ""
                                  }
                                },
                                {
                                  "definition": "tile/text",
                                  "attributes": {
                                    "text": "Has Metadata Removed",
                                    "variant": "body"
                                  }
                                }
                              ]
                            },
                            {
                              "definition": "tile/column",
                              "attributes": {
                                "gap": "xs"
                              },
                              "children": [
                                {
                                  "definition": "tile/text",
                                  "attributes": {
                                    "text": "Build Duration In Seconds",
                                    "variant": "body",
                                    "weight": "semibold"
                                  }
                                },
                                {
                                  "definition": "tile/text",
                                  "attributes": {
                                    "text": "{!$buildDurationInSeconds}",
                                    "variant": "body"
                                  }
                                }
                              ]
                            },
                            {
                              "definition": "tile/column",
                              "attributes": {
                                "gap": "xs"
                              },
                              "children": [
                                {
                                  "definition": "tile/text",
                                  "attributes": {
                                    "text": "Language",
                                    "variant": "body",
                                    "weight": "semibold"
                                  }
                                },
                                {
                                  "definition": "tile/text",
                                  "attributes": {
                                    "text": "{!$language}",
                                    "variant": "body"
                                  }
                                }
                              ]
                            },
                            {
                              "definition": "tile/column",
                              "attributes": {
                                "gap": "xs"
                              },
                              "children": [
                                {
                                  "definition": "tile/text",
                                  "attributes": {
                                    "text": "Salesforce Release Version",
                                    "variant": "body",
                                    "weight": "semibold"
                                  }
                                },
                                {
                                  "definition": "tile/text",
                                  "attributes": {
                                    "text": "{!$releaseVersion}",
                                    "variant": "body"
                                  }
                                }
                              ]
                            },
                            {
                              "definition": "tile/column",
                              "attributes": {
                                "gap": "xs"
                              },
                              "children": [
                                {
                                  "definition": "tile/text",
                                  "attributes": {
                                    "text": "Created By",
                                    "variant": "body",
                                    "weight": "semibold"
                                  }
                                },
                                {
                                  "definition": "tile/text",
                                  "attributes": {
                                    "text": "{!$createdBy}",
                                    "variant": "body"
                                  }
                                }
                              ]
                            },
                            {
                              "definition": "tile/column",
                              "attributes": {
                                "gap": "xs"
                              },
                              "children": [
                                {
                                  "definition": "tile/text",
                                  "attributes": {
                                    "text": "Created Date",
                                    "variant": "body",
                                    "weight": "semibold"
                                  }
                                },
                                {
                                  "definition": "tile/text",
                                  "attributes": {
                                    "text": "{!$createdDate}",
                                    "variant": "body"
                                  }
                                }
                              ]
                            }
                          ]
                        }
                      ]
                    }
                  ]
                },
                {
                  "definition": "tile/row",
                  "attributes": {
                    "gap": "sm"
                  },
                  "children": [
                    {
                      "definition": "tile/button",
                      "attributes": {
                        "label": "Back to package versions",
                        "variant": "secondary",
                        "actions": {
                          "click": [
                            {
                              "definition": "action/sendMessage",
                              "attributes": {
                                "content": "{!$package2Id}"
                              }
                            }
                          ]
                        }
                      }
                    },
                    {
                      "definition": "tile/button",
                      "attributes": {
                        "label": "View Subscribers",
                        "variant": "secondary",
                        "actions": {
                          "click": [
                            {
                              "definition": "action/sendMessage",
                              "attributes": {
                                "content": "{!$subscriberPackageVersionId}"
                              }
                            }
                          ]
                        }
                      }
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
